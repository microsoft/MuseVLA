{
    "vla_name": "VITRA_Paligemma",
    "task_name": "musevla_local_smoke_test",
    "task_mode": "vlm_vla_cofinetune",
    "model": "vitra_paligemma2",
    "fwd_pred_next_n": 16,
    "seed": 42,
    "batch_size": 1,
    "total_batch_size": 1,
    "output_root": "./outputs/local_train/checkpoints",
    "log_root": "./outputs/local_train/logs",
    "cache_root": "./outputs/local_train/cache",
    "pretrain_path": null,
    "model_load_path": null,
    "resume": false,
    "wandb_project": "musevla_local",
    "wandb_entity": null,
    "save_steps": 50,
    "epoch_save_interval": 1,
    "use_bf16": true,
    "use_fov": false,
    "untied_cognition_token": true,
    "use_state": "DiT",
    "loss_type": "robot",
    "train_setup": {
        "freeze_option": "freeze_encoder"
    },
    "vlm_vla": {
        "random_sample_sensor": false,
        "sensor_masked": true,
        "RGB_only": false,
        "background_modes": "grey",
        "vlm_loss_weight": 1e-4,
        "action_loss_weight": 1.0,
        "data_mix_sensor": "acoustic,radar,thermal",
        "jump_frame": 4,
        "adaptive_jump_frame": 2,
        "threshold": 0.087,
        "random_drop_RGB": 0.1,
        "sensor_input_all": true,
        "use_end_pose": true,
        "use_delta_pose": true,
        "relative_to_t0": false,
        "radar_fix_start_frame": false,
        "data_fraction": 1.0,
        "vitra_data_fraction": 0.25,
        "filter_invalid_videos": false,
        "train_seg_token": false,
        "max_samples": 4
    },
    "state_encoder": {
        "state_dim": 212
    },
    "action_model": {
        "model_type": "DiT-B",
        "token_size": 2304,
        "action_dim": 192,
        "hidden_size": 1024
    },
    "vlm": {
        "type": "PaliGemmaForConditionalGeneration",
        "name": "paligemma",
        "pretrained_model_name_or_path": "google/paligemma2-3b-mix-224"
    },
    "trainer": {
        "sharding_strategy": "shard-grad-op",
        "strategy": "fsdp_paligemma_with_checkpointing",
        "lr_scheduler_type": "backbone-freeze-warmup",
        "gradient_clip_val": 1.0,
        "learning_rate": 1e-5,
        "weight_decay": 1e-1,
        "max_epochs": 1,
        "max_steps": 5,
        "reduce_in_full_precision": true,
        "enable_mixed_precision_training": true,
        "enable_gradient_checkpointing": true,
        "action_model_learning_rate": 1e-5,
        "llm_freeze_step": 0,
        "warmup_ratio": null,
        "optimizer_betas": [0.9, 0.95]
    },
    "train_dataset": {
        "data_root_dir": "<DATA_ROOT>",
        "augmentation": false,
        "set_none_ratio": 0.0,
        "data_mix": "muse_robot",
        "num_workers": 0,
        "prefetch_factor": null,
        "flip_augmentation": 0.0,
        "action_type": "angle",
        "use_rel": false,
        "clip_len": null,
        "normalization": true
    },
    "repeated_diffusion_steps": 1
}
