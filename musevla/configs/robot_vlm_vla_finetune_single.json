{
    "vla_name": "VITRA_Paligemma",
    "task_name": "VLMpret_0_VLApret_None_0_Finetune_realRobot_50k",
    "task_mode": "vlm_vla_cofinetune",
    "model": "vitra_paligemma2",
    "fwd_pred_next_n": 16,
